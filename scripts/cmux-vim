#!/usr/bin/env python3
"""cmux 오른쪽 pane 에서 vim 으로 파일을 연다.

- 지금 pane 오른쪽에 pane 이 있으면 그 pane 에 새 탭을 만든다
- 없으면 오른쪽으로 split 해서 새 pane 을 만든다

사용: cmux-vim <file> [<file> ...]   (여러 개면 vim -O 로 한 탭에 연다)
"""
import json
import os
import shlex
import subprocess
import sys


def cmux_json(*args):
    out = subprocess.run(["cmux", "--json", *args], check=True, capture_output=True, text=True).stdout
    return json.loads(out)


def find_right_pane(panes, me):
    f = me["pixel_frame"]
    right_edge = f["x"] + f["width"]
    best, best_overlap = None, 0
    for p in panes:
        if p["ref"] == me["ref"]:
            continue
        g = p["pixel_frame"]
        if abs(g["x"] - right_edge) > 2:
            continue
        overlap = min(f["y"] + f["height"], g["y"] + g["height"]) - max(f["y"], g["y"])
        if overlap > best_overlap:
            best, best_overlap = p, overlap
    return best


def main():
    if len(sys.argv) < 2:
        sys.exit("usage: cmux-vim <file> [<file> ...]")
    files = [os.path.abspath(os.path.expanduser(a)) for a in sys.argv[1:]]
    command = "vim " + ("-O " if len(files) > 1 else "") + " ".join(shlex.quote(f) for f in files)

    my_pane_ref = cmux_json("identify")["caller"]["pane_ref"]
    panes = cmux_json("list-panes")["panes"]
    me = next(p for p in panes if p["ref"] == my_pane_ref)
    right = find_right_pane(panes, me)

    if right:
        args = ["new-surface", "--pane", right["ref"], "--command", command, "--focus", "true"]
    else:
        args = ["new-split", "right", "--command", command, "--focus", "true"]
    subprocess.run(["cmux", *args], check=True)


if __name__ == "__main__":
    main()
